# Backend origin (no trailing slash, no /api). The app calls ${VITE_API_URL}/api/*
# and loads property photos from ${VITE_API_URL}/uploads/*.
# Leave unset for local development: the Vite dev server proxies /api and
# /uploads to http://localhost:5000 (see vite.config.js).
# Production (set in the Vercel project's Environment Variables):
VITE_API_URL=https://ledger-onboard-backend.onrender.com
