# ── Ledger OnBoard Backend — Environment Configuration ──────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (local example — replace with Atlas SRV URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/ledger_onboard

# Auth / JWT
JWT_SECRET=replace-with-a-long-random-secret-never-commit-the-real-one
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Account inactivity lifecycle
ACCOUNT_ARCHIVE_WARNING_DAYS=25
ACCOUNT_ARCHIVE_DAYS=30
ACCOUNT_LIFECYCLE_CRON=0 2 * * *

# Email (used for OTP, archive warnings, activation emails)
# EMAIL_TRANSPORT=console just logs the email instead of sending it — the
# OTP will only ever appear in the backend terminal. To make OTPs actually
# arrive in a real inbox, set EMAIL_TRANSPORT to anything else (e.g. "smtp")
# and fill in real SMTP_* values below. Never commit real credentials here.
#
# Quick option for dev/testing: Gmail SMTP with an App Password (requires
# 2-Step Verification enabled on the Gmail account) —
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-gmail-address@gmail.com
#   SMTP_PASS=your-16-character-app-password   (NOT your normal Gmail password)
# Any other SMTP-compatible provider (SendGrid, Mailgun, Resend, etc.) also
# works the same way — just point SMTP_HOST/PORT/USER/PASS at it.
EMAIL_TRANSPORT=console
EMAIL_FROM="Ledger OnBoard <no-reply@ledgeronboard.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# OTP
OTP_TTL_MINUTES=10

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
PAYMENT_RATE_LIMIT_WINDOW_MINUTES=15
PAYMENT_RATE_LIMIT_MAX=20

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=50
