# ── Ledger OnBoard Backend — Environment Configuration ──────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=5000
# Frontend origin(s) allowed by CORS, comma-separated, no trailing slash. The
# first one is the fallback for email links when EMAIL_APP_URL is unset.
# Production example: CLIENT_ORIGIN=https://ledger-onboard.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Public frontend URL for email buttons and caretaker activation links, independent
# of CORS. Set on the backend hosting service too; no trailing slash or /api.
# Leave blank to use the first CLIENT_ORIGIN (useful for entirely local testing).
# Production value: https://ledger-onboard.vercel.app
EMAIL_APP_URL=
# Proxy hops to trust for the client IP (rate limiting). Defaults to 1 when
# NODE_ENV=production (Render), otherwise 0.
# TRUST_PROXY=1

# MongoDB (local example — replace with Atlas SRV URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/ledger_onboard

# Auth / JWT
JWT_SECRET=replace-with-a-long-random-secret-never-commit-the-real-one
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Account inactivity lifecycle
ACCOUNT_ARCHIVE_WARNING_DAYS=25
ACCOUNT_ARCHIVE_DAYS=30
ACCOUNT_LIFECYCLE_CRON=0 2 * * *

# Email: console (print to this terminal), smtp (SMTP_* below, e.g. Gmail with an App Password),
# or brevo (Brevo's HTTPS API; use this on Render's free plan, which blocks outgoing SMTP).
EMAIL_TRANSPORT=console
EMAIL_FROM="Ledger OnBoard <no-reply@ledgeronboard.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Only for EMAIL_TRANSPORT=brevo. EMAIL_FROM's address must be a verified sender in Brevo.
BREVO_API_KEY=
# Longest a single email send may take before failing with an error (milliseconds).
EMAIL_TIMEOUT_MS=10000

# OTP
OTP_TTL_MINUTES=10

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_MAX=30
SENSITIVE_AUTH_RATE_LIMIT_WINDOW_MINUTES=15
SENSITIVE_AUTH_RATE_LIMIT_MAX=8
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=900
PAYMENT_RATE_LIMIT_WINDOW_MINUTES=15
PAYMENT_RATE_LIMIT_MAX=20
PAYMENT_SUBMISSION_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=15
UPLOAD_RATE_LIMIT_MAX=30
UTILITY_RATE_LIMIT_WINDOW_MINUTES=15
UTILITY_RATE_LIMIT_MAX=30

# File uploads — stored in MongoDB GridFS (bucket "uploads"), not on disk.
# UPLOAD_DIR is only the source folder for `npm run migrate:uploads`, which copies
# files from the old on-disk storage into GridFS.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=50

# Demo accounts created by `npm run seed` (local use only; never commit the real value).
# Must be strong: 8+ chars with upper, lower, number, and symbol.
SEED_DEMO_PASSWORD=
